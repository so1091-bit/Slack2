rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자: 로그인한 사람은 모두 읽기, 본인 문서만 쓰기 (이름, 접속시각, 입력중 상태)
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'lastSeen', 'typing', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20;
    }

    // 채팅 메시지: 채널 목록은 index.html 의 CHANNELS 와 맞춰야 함
    match /channels/{cid}/messages/{mid} {
      allow read: if request.auth != null && cid in ['general', 'lunch', 'random'];

      allow create: if request.auth != null
        && cid in ['general', 'lunch', 'random']
        && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt', 'reactions'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time
        && request.resource.data.reactions == {};

      // 다른 사람은 반응(reactions)만 바꿀 수 있음
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.reactions is map;

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
